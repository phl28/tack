{
  "_comment": "Canonical config. 'common' holds knobs shared across harnesses, projected into each one's own key by that harness's config_map. 'harness' blocks are raw passthrough for things only one tool understands.",

  "common": {
    "theme": "dark",
    "web_search": true
  },

  "harness": {
    "claude": {
      "effortLevel": "medium",
      "tui": "fullscreen",
      "hooks": {
        "SessionStart": [
          {
            "matcher": "*",
            "hooks": [
              { "type": "command", "command": "bash '$HOME/.claude/hooks/example-hook.sh' session", "timeout": 10 }
            ]
          }
        ]
      }
    },

    "codex": {
      "model": "gpt-5-codex",
      "features": { "hooks": true }
    },

    "opencode": {
      "$schema": "https://opencode.ai/config.json",
      "autoupdate": false
    }
  }
}
